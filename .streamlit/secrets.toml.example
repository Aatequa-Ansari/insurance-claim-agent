# .streamlit/secrets.toml.example
#
# On Streamlit Community Cloud, copy these keys into your app's
# Settings -> Secrets panel (do NOT commit a real secrets.toml -- it's
# gitignored). Locally, use .env instead; this file is only a reference
# for the cloud deployment format.

GOOGLE_API_KEY = "your_google_gemini_api_key_here"
GEMINI_MODEL = "gemini-2.5-flash"
ENVIRONMENT = "production"
