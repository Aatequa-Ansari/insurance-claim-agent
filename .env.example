# ------------------------------------------------------------------
# Enterprise AI Insurance Claim Processing Agent -- environment config
#
# Copy this file to `.env` for local development:
#   cp .env.example .env
# Then fill in your own values. Never commit the real `.env` file.
#
# On Streamlit Community Cloud, set these same keys under
# App Settings -> Secrets (as TOML), instead of using a .env file.
# ------------------------------------------------------------------

# Required: Google Gemini API key (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Optional: model overrides
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048
LLM_REQUEST_TIMEOUT_SECONDS=60

# Optional: retry behavior
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=1.5

# Optional: app metadata / logging
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_DIR=logs
REPORTS_DIR=reports

# Optional: business rule overrides
HIGH_VALUE_CLAIM_THRESHOLD=500000
HIGH_VALUE_COVERAGE_FRACTION=0.8
FRAUD_HIGH_RISK_SCORE=70
FRAUD_MEDIUM_RISK_SCORE=40
